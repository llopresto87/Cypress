# ----- Optional: documentation MCP -----
# Context7 provides current library docs. With it configured,
# research-scout fetches version-pinned docs faster than crawling.
#
# [mcp_servers.context7]
# command = "npx"
# args = ["-y", "@upstash/context7-mcp"]
# env = { CONTEXT7_API_KEY = "..." }
# timeout_secs = 30
